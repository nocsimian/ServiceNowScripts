        resolvedAt:   false
    },
    {
        label:        'In Progress (High)',
        state:        '2',
        priority:     null,         // randomly assigned from pool below
        priorityPool: ['2', '2', '3'],
        holdReason:   null,
        resolvedAt:   false
    },
    {
        label:        'In Progress',
        state:        '2',
        priority:     null,
        priorityPool: ['2', '3', '4'],
        holdReason:   null,
        resolvedAt:   false
    },
    {
        label:        'On Hold',
        state:        '3',
        priority:     null,
        priorityPool: ['2', '3', '3', '4'],
        holdReason:   null,         // assigned randomly below
        resolvedAt:   false
    },
    {
        label:        'Resolved',
        state:        '6',
        priority:     null,
        priorityPool: ['2', '3', '4'],
        holdReason:   null,
