// ─────────────────────────────────────────────────────────────
// INCIDENT SLOT DEFINITIONS
// Exactly 5 slots — state, priority pool, and hold reason per slot
// ─────────────────────────────────────────────────────────────
var INCIDENT_SLOTS = [
