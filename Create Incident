// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function offsetNow(offsetMs) {
    var gdt = new GlideDateTime();
    gdt.setNumericValue(gdt.getNumericValue() + offsetMs);
    return gdt;
}

var minMs  = 60 * 1000;
var hrMs   = 60 * minMs;
var dayMs  = 24 * hrMs;

/**
 * Build contextually correct timestamps per incident state.
 *
 *  New          — opened 5 min – 4 hrs ago
 *  In Progress  — opened 1 – 24 hrs ago
 *  On Hold      — opened 6 hrs – 3 days ago, put on hold recently
 *  Resolved     — opened 1 – 7 days ago, resolved 1 hr – 2 days ago
 */
function buildTimings(stateVal) {
    var t = {};

    if (stateVal === '1') {                      // New
        t.opened   = offsetNow(-randInt(5 * minMs,  4 * hrMs));
        t.resolved = null;

    } else if (stateVal === '2') {               // In Progress
        t.opened   = offsetNow(-randInt(1 * hrMs,  24 * hrMs));
        t.resolved = null;

    } else if (stateVal === '3') {               // On Hold
        t.opened   = offsetNow(-randInt(6 * hrMs,   3 * dayMs));
        t.resolved = null;

    } else if (stateVal === '6') {               // Resolved
        var resolvedAgo = randInt(1 * hrMs, 2 * dayMs);
        var openedAgo   = resolvedAgo + randInt(30 * minMs, 5 * dayMs);
        t.opened        = offsetNow(-openedAgo);
        t.resolved      = offsetNow(-resolvedAgo);
    }

    return t;
}

// ─────────────────────────────────────────────────────────────
// LOOK UP CIs
// ─────────────────────────────────────────────────────────────

function resolveCIs(nameList) {
    var resolved = {};
    for (var i = 0; i < nameList.length; i++) {
        var ciName = nameList[i];
        var gr = new GlideRecord(CONFIG.ciTable);
        gr.addQuery('name', ciName);
        gr.setLimit(1);
        gr.query();
        if (gr.next()) {
            resolved[ciName] = gr.getUniqueValue();
            gs.log('CI found: "' + ciName + '" → sys_id ' + resolved[ciName], 'DemoIncidentGen');
        } else {
            gs.logWarning('CI NOT FOUND: "' + ciName + '" in table ' + CONFIG.ciTable + ' — skipping.', 'DemoIncidentGen');
        }
    }
    return resolved;
}

// ─────────────────────────────────────────────────────────────
// INSERT ONE INCIDENT
// ─────────────────────────────────────────────────────────────

function insertIncident(ciSysId, ciName, slot, tmpl, idx) {

    var priority  = slot.priority || pick(slot.priorityPool);
    var timings   = buildTimings(slot.state);
    var shortDesc = tmpl.shortDesc.replace(/\{ci\}/g, ciName);
    var descBody  = tmpl.description.replace(/\{ci\}/g, ciName);
    var holdReason = (slot.state === '3') ? pick(HOLD_REASONS) : null;
    var resolutionNote = slot.resolvedAt ? pick(RESOLUTION_NOTES) : null;

    var PRIORITY_LABELS = { '1': 'Critical', '2': 'High', '3': 'Moderate', '4': 'Low' };
    var STATE_LABELS    = { '1': 'New', '2': 'In Progress', '3': 'On Hold', '6': 'Resolved' };

    if (CONFIG.logResults) {
        gs.log(
            '  [' + (idx + 1) + '] ' + STATE_LABELS[slot.state] +
            ' | P' + priority + ' ' + PRIORITY_LABELS[priority] +
            ' | Cat: ' + tmpl.category +
            ' | "' + shortDesc + '"',
            'DemoIncidentGen'
        );
    }

    if (CONFIG.dryRun) { return true; }

    try {
        var gr = new GlideRecord('incident');
        gr.initialize();

        gr.setValue('cmdb_ci',           ciSysId);
        gr.setValue('state',             slot.state);
        gr.setValue('priority',          priority);
        gr.setValue('impact',            tmpl.impact);
        gr.setValue('urgency',           tmpl.urgency);
        gr.setValue('category',          tmpl.category);
        gr.setValue('subcategory',       tmpl.subcategory);
        gr.setValue('short_description', shortDesc);
        gr.setValue('description',       descBody);
        gr.setValue('opened_at',         timings.opened);
        gr.setValue('sys_created_on',    timings.opened);

        if (holdReason) {
            gr.setValue('hold_reason', holdReason);
        }

        if (timings.resolved) {
            gr.setValue('resolved_at',    timings.resolved);
            gr.setValue('close_notes',    resolutionNote);
            gr.setValue('resolved_by',    gs.getUserID());
        }

        gr.insert();
        return true;

    } catch (ex) {
        gs.logError('Failed to insert incident for "' + ciName + '": ' + ex.message, 'DemoIncidentGen');
        return false;
    }
}

// ─────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────

gs.log('=== Demo Incident Generator START (' +
    (CONFIG.dryRun ? 'DRY RUN' : 'LIVE') + ') ===', 'DemoIncidentGen');

// Shuffle template array for variety across CIs
function shuffled(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
}

var ciMap       = resolveCIs(CI_NAMES);
var totalInsert = 0;
var totalSkip   = 0;
var totalError  = 0;

for (var ciName in ciMap) {
    var ciSysId   = ciMap[ciName];
    var templates = shuffled(INCIDENT_TEMPLATES);

    gs.log('--- Generating incidents for: "' + ciName + '" ---', 'DemoIncidentGen');

    // Slot 0 always uses a Critical/P1 template (first 3 templates are P1-worthy)
    var criticalTmpl = pick(INCIDENT_TEMPLATES.slice(0, 3));

    for (var s = 0; s < INCIDENT_SLOTS.length; s++) {
        var slot = INCIDENT_SLOTS[s];
        var tmpl = (s === 0) ? criticalTmpl : templates[s % templates.length];
        var ok   = insertIncident(ciSysId, ciName, slot, tmpl, s);

        if (CONFIG.dryRun) { totalSkip++; }
        else if (ok)        { totalInsert++; }
        else                { totalError++; }
    }
}

// ── Summary ──────────────────────────────────────────────────
gs.log('=== Demo Incident Generator COMPLETE ===', 'DemoIncidentGen');
gs.log('CIs processed    : ' + Object.keys(ciMap).length + ' of ' + CI_NAMES.length, 'DemoIncidentGen');
gs.log('Records inserted : ' + totalInsert, 'DemoIncidentGen');
gs.log('Records skipped  : ' + totalSkip + (CONFIG.dryRun ? ' (dry run)' : ''), 'DemoIncidentGen');
gs.log('Errors           : ' + totalError, 'DemoIncidentGen');
