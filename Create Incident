/**
 * ServiceNow Background Script: Generate Demo Incident Records
 *
 * Purpose: Creates 5 incident records per CI in the target list,
 *          distributed across 4 states, with at least 1 Critical
 *          priority incident guaranteed per CI.
 *
 *   Slot distribution (5 per CI):
 *   [1]  New           — state: 1  | priority: 1 (Critical) GUARANTEED
 *   [2]  In Progress   — state: 2  | random priority 2-3
 *   [3]  In Progress   — state: 2  | random priority 2-4
 *   [4]  On Hold       — state: 3  | random priority 3-4
 *   [5]  Resolved      — state: 6  | random priority 2-4
 *
 * Instructions:
 *   1. Navigate to System Definition > Scripts - Background
 *   2. Paste this script and click "Run script"
 *   3. Adjust CONFIG values if needed before running
 *
 * Compatible with: ServiceNow Rome / San Diego / Tokyo / Utah / Vancouver+
 *
 * ServiceNow Incident state values (OOTB):
 *   1 = New   2 = In Progress   3 = On Hold
 *   6 = Resolved   7 = Closed
 *
 * Priority values:
 *   1 = Critical   2 = High   3 = Moderate   4 = Low
 *
 * Hold reason values:
 *   1 = Awaiting Caller   2 = Awaiting Change   3 = Awaiting Problem   5 = Awaiting Vendor
 */

// ─────────────────────────────────────────────────────────────
// CONFIG
// ─────────────────────────────────────────────────────────────
var CONFIG = {
