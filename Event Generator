// ─────────────────────────────────────────────────────────────
// HELPER UTILITIES
// ─────────────────────────────────────────────────────────────

/** Pick a random element from an array */
function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

/** Resolve a token that may be a value or an array */
function resolveToken(val) {
    return Array.isArray(val) ? pick(val) : val;
}

/** Return a GlideDateTime offset back by a random number of minutes */
function randomPastTime(maxMinutesAgo) {
    var gdt = new GlideDateTime();
    var offsetMs = Math.floor(Math.random() * maxMinutesAgo * 60 * 1000);
    gdt.setNumericValue(gdt.getNumericValue() - offsetMs);
    return gdt;
}

/** Build the message string from a template, replacing {tokens} */
function buildMessage(template, tokens) {
    var msg = template;
    for (var key in tokens) {
        msg = msg.replace(new RegExp('{' + key + '}', 'g'), tokens[key]);
    }
    return msg;
}

/** Map numeric severity to ServiceNow em_event severity string */
function severityLabel(num) {
    var map = { 1: 'clear', 2: 'info', 3: 'warning', 4: 'minor', 5: 'major', 6: 'critical' };
    return map[num] || 'warning';
}

// ─────────────────────────────────────────────────────────────
// EVENT GENERATOR
// ─────────────────────────────────────────────────────────────

/**
 * Build one event record object from a randomly chosen template.
 */
function generateEvent() {
    var tmpl    = pick(EVENT_TEMPLATES);
    var node    = pick(tmpl.nodes);
    var sev     = pick(tmpl.severities);
    var value   = resolveToken(tmpl.values);
    var thresh  = resolveToken(tmpl.thresholds);

    // Build token map for message substitution
    var tokens = {
        node:      node,
        value:     value,
        threshold: thresh
    };

    // Merge any extra token arrays defined in the template
    if (tmpl.extraTokens) {
        for (var k in tmpl.extraTokens) {
            tokens[k] = pick(tmpl.extraTokens[k]);
        }
    }

    var message = buildMessage(tmpl.messageTemplate, tokens);

    // additional_info as a JSON string — useful for alert rules / parsing
    var additionalInfo = JSON.stringify({
        metric_name:  tmpl.metricName,
        metric_value: value,
        threshold:    thresh,
        source_host:  node,
        datacenter:   pick(['DC-East', 'DC-West', 'DC-Central']),
        environment:  pick(['Production', 'Production', 'Staging', 'DR'])  // prod weighted
    });

    return {
        source:          tmpl.source,
        event_class:     tmpl.type,
        resource:        tmpl.resource,
        node:            node,
        severity:        sev,
        description:     message,
        additional_info: additionalInfo,
        time_of_event:   randomPastTime(CONFIG.timeSpreadMinutes),
        type:            tmpl.type
    };
}

// ─────────────────────────────────────────────────────────────
// MAIN — insert events into em_event
// ─────────────────────────────────────────────────────────────

var inserted = 0;
var skipped  = 0;
var errors   = [];

gs.log('=== Demo Event Generator START (' +
    (CONFIG.dryRun ? 'DRY RUN' : 'LIVE') + ') ===', 'DemoEventGen');

for (var i = 0; i < CONFIG.eventCount; i++) {
    try {
        var evt = generateEvent();

        if (CONFIG.logResults) {
            gs.log(
                '[' + (i + 1) + '/' + CONFIG.eventCount + '] ' +
                severityLabel(evt.severity).toUpperCase() + ' | ' +
                evt.source + ' | ' + evt.node + ' | ' + evt.description,
                'DemoEventGen'
            );
        }

        if (!CONFIG.dryRun) {
            var gr = new GlideRecord('em_event');
            gr.initialize();
            gr.setValue('source',          evt.source);
            gr.setValue('event_class',     evt.event_class);
            gr.setValue('resource',        evt.resource);
            gr.setValue('node',            evt.node);
            gr.setValue('severity',        evt.severity);
            gr.setValue('description',     evt.description);
            gr.setValue('additional_info', evt.additional_info);
            gr.setValue('time_of_event',   evt.time_of_event);
            gr.setValue('type',            evt.type);
            gr.insert();
            inserted++;
        } else {
            skipped++;
        }
    } catch (ex) {
        errors.push('Event ' + (i + 1) + ': ' + ex.message);
        gs.logError('Failed to insert event ' + (i + 1) + ': ' + ex.message, 'DemoEventGen');
    }
}

// ── Summary ──────────────────────────────────────────────────
gs.log('=== Demo Event Generator COMPLETE ===', 'DemoEventGen');
gs.log('Inserted : ' + inserted, 'DemoEventGen');
gs.log('Skipped  : ' + skipped + (CONFIG.dryRun ? ' (dry run)' : ''), 'DemoEventGen');
gs.log('Errors   : ' + errors.length, 'DemoEventGen');
if (errors.length > 0) {
    gs.log('Error details: ' + errors.join(' | '), 'DemoEventGen');
}
