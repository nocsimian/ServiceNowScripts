// ─────────────────────────────────────────────────────────────
// SEVERITY LABEL MAP  (for logging)
// ─────────────────────────────────────────────────────────────
var SEVERITY_LABELS = {
    1: 'CLEAR',
    2: 'INDETERMINATE',
    3: 'WARNING',
    4: 'MINOR',
    5: 'MAJOR',
    6: 'CRITICAL'
};

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function offsetNow(offsetMs) {
    var gdt = new GlideDateTime();
    gdt.setNumericValue(gdt.getNumericValue() + offsetMs);
    return gdt;
}

var minMs = 60 * 1000;
var hrMs  = 60 * minMs;
var dayMs = 24 * hrMs;

/**
 * Build a realistic time_of_event for each severity level.
 *   Critical / Major  — very recent (1 – 60 min ago)
 *   Minor / Warning   — somewhat recent (30 min – 12 hrs ago)
 *   Clear             — recent enough to follow a prior alert (5 – 90 min ago)
 */
function buildEventTime(severity) {
    if (severity === 6 || severity === 5) {
        return offsetNow(-randInt(1 * minMs, 60 * minMs));
    } else if (severity === 4 || severity === 3) {
        return offsetNow(-randInt(30 * minMs, 12 * hrMs));
    } else if (severity === 2) {
        return offsetNow(-randInt(1 * hrMs, 24 * hrMs));
    } else {
        // Clear
        return offsetNow(-randInt(5 * minMs, 90 * minMs));
    }
}

/** Replace {ci} and {value}/{drop} tokens in message template */
function buildMessage(template, ciName, addlInfo) {
    var msg = template.replace(/\{ci\}/g, ciName);
    if (addlInfo && addlInfo.value !== undefined) {
        msg = msg.replace(/\{value\}/g, addlInfo.value);
    }
    if (addlInfo && addlInfo.drop !== undefined) {
        msg = msg.replace(/\{drop\}/g, addlInfo.drop);
    } else {
        msg = msg.replace(/\{drop\}/g, randInt(50, 85));
    }
    return msg;
}

// ─────────────────────────────────────────────────────────────
// LOOK UP CIs
// ─────────────────────────────────────────────────────────────

function resolveCIs(nameList) {
    var resolved = {};
    for (var i = 0; i < nameList.length; i++) {
        var ciName = nameList[i];
        var gr = new GlideRecord(CONFIG.ciTable);
        gr.addQuery('name', ciName);
        gr.setLimit(1);
        gr.query();
        if (gr.next()) {
            resolved[ciName] = gr.getUniqueValue();
            gs.log('CI found: "' + ciName + '" → sys_id ' + resolved[ciName], 'DemoEventGen');
        } else {
            gs.logWarning('CI NOT FOUND: "' + ciName + '" in table ' + CONFIG.ciTable + ' — skipping.', 'DemoEventGen');
        }
    }
    return resolved;
}

// ─────────────────────────────────────────────────────────────
// INSERT ONE EVENT
// ─────────────────────────────────────────────────────────────

function insertEvent(ciSysId, ciName, slot, tmpl, idx) {

    var severity    = (slot.severity !== null) ? slot.severity : pick(slot.severityPool);
    var eventTime   = buildEventTime(severity);
    var message     = buildMessage(tmpl.messageTemplate, ciName, tmpl.additionalInfo);
    var addlInfoStr = JSON.stringify(
        gs.extend(tmpl.additionalInfo || {}, {
            ci_name:     ciName,
            environment: pick(['Production', 'Production', 'Staging', 'DR']),
            datacenter:  pick(['DC-East', 'DC-West', 'DC-Central'])
        })
    );

    if (CONFIG.logResults) {
        gs.log(
            '  [' + (idx + 1) + '] ' + SEVERITY_LABELS[severity] +
            ' | Source: ' + tmpl.source +
            ' | Type: '   + tmpl.type +
            ' | Node: '   + ciName +
            ' | ' + message.substring(0, 80) + (message.length > 80 ? '...' : ''),
            'DemoEventGen'
        );
    }

    if (CONFIG.dryRun) { return true; }

    try {
        var gr = new GlideRecord('em_event');
        gr.initialize();
        gr.setValue('source',          tmpl.source);
        gr.setValue('event_class',     tmpl.type);
        gr.setValue('resource',        tmpl.resource);
        gr.setValue('node',            ciName);
        gr.setValue('ci',              ciSysId);
        gr.setValue('severity',        severity);
        gr.setValue('description',     message);
        gr.setValue('additional_info', addlInfoStr);
        gr.setValue('time_of_event',   eventTime);
        gr.setValue('type',            tmpl.type);
        gr.insert();
        return true;

    } catch (ex) {
        gs.logError('Failed to insert event for "' + ciName + '": ' + ex.message, 'DemoEventGen');
        return false;
    }
}

// ─────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────

gs.log('=== Demo Event Management Generator START (' +
    (CONFIG.dryRun ? 'DRY RUN' : 'LIVE') + ') ===', 'DemoEventGen');

function shuffled(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
}

var ciMap       = resolveCIs(CI_NAMES);
var totalInsert = 0;
var totalSkip   = 0;
var totalError  = 0;

for (var ciName in ciMap) {
    var ciSysId   = ciMap[ciName];
    var templates = shuffled(EVENT_TEMPLATES);

    gs.log('--- Generating events for: "' + ciName + '" ---', 'DemoEventGen');

    // Slot 0 always gets a high-impact template (first 4 are availability/outage level)
    var criticalTmpl = pick(EVENT_TEMPLATES.slice(0, 4));

    for (var s = 0; s < EVENT_SLOTS.length; s++) {
        var slot = EVENT_SLOTS[s];
        var tmpl = (s === 0) ? criticalTmpl : templates[s % templates.length];
        var ok   = insertEvent(ciSysId, ciName, slot, tmpl, s);

        if (CONFIG.dryRun) { totalSkip++; }
        else if (ok)        { totalInsert++; }
        else                { totalError++; }
    }
}

// ── Summary ──────────────────────────────────────────────────
gs.log('=== Demo Event Management Generator COMPLETE ===', 'DemoEventGen');
gs.log('CIs processed    : ' + Object.keys(ciMap).length + ' of ' + CI_NAMES.length, 'DemoEventGen');
gs.log('Records inserted : ' + totalInsert, 'DemoEventGen');
gs.log('Records skipped  : ' + totalSkip + (CONFIG.dryRun ? ' (dry run)' : ''), 'DemoEventGen');
gs.log('Errors           : ' + totalError, 'DemoEventGen');
