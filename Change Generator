/**
 * ServiceNow Background Script: Generate Demo Change Records
 *
 * Purpose: Creates 5 change_request records per CI in the target list,
 *          distributed across 4 lifecycle states:
 *
 *   [1]  New / Draft          — state: -5   (just created, not yet submitted)
 *   [2]  Assess / Authorize   — state:  -4  (under review / awaiting approval)
 *   [3]  Implement (In Prog.) — state:   2  (approved, work underway right now)
 *   [4]  Closed / Complete    — state:   3  (work finished, record closed)
 *   [5]  Closed / Complete    — state:   3  (second closed change for history depth)
 *
 *   Timestamps are generated so each state has contextually realistic dates.
 *
 * Instructions:
 *   1. Navigate to System Definition > Scripts - Background
 *   2. Paste this script and click "Run script"
 *   3. Adjust CONFIG values if needed before running
 *
 * Compatible with: ServiceNow Rome / San Diego / Tokyo / Utah / Vancouver+
 *
 * NOTE: ServiceNow Change state integer values (OOTB):
 *   -5 = New          -4 = Assess       -3 = Authorize
 *   -2 = Scheduled     2 = Implement      3 = Review
 *    0 = Closed         4 = Canceled
 *   "Closed Complete" uses close_code = 'successful' with state = 0
 */

// ─────────────────────────────────────────────────────────────
// CONFIG
// ─────────────────────────────────────────────────────────────
var CONFIG = {
    dryRun:     false,    // true = log only, no DB inserts
    logResults: true,     // print each record to the system log
    ciTable:    'cmdb_ci' // table to look up CIs in
};

// ─────────────────────────────────────────────────────────────
// TARGET CI LIST  (matched on the 'name' field in cmdb_ci)
// ─────────────────────────────────────────────────────────────
var CI_NAMES = [
    'Amazon Web Services',
    'WelcoMe AU'
];

// ─────────────────────────────────────────────────────────────
// CHANGE STATE DEFINITIONS
// 5 slots per CI — one assigned state each
// ─────────────────────────────────────────────────────────────
var CHANGE_STATES = [
    {
        label:      'New / Draft',
        state:      '-5',
        closeCode:  null,
        closeNotes: null
    },
    {
        label:      'Assess / Authorize',
        state:      '-4',
        closeCode:  null,
        closeNotes: null
    },
    {
        label:      'Implement (In Progress)',
        state:      '2',
        closeCode:  null,
        closeNotes: null
    },
    {
        label:      'Closed / Complete',
        state:      '0',
        closeCode:  'successful',
        closeNotes: 'Change implemented successfully. All tasks completed and verified.'
    },
    {
        label:      'Closed / Complete',
        state:      '0',
        closeCode:  'successful_issues',
        closeNotes: 'Change completed with minor issues noted. Post-implementation review scheduled.'
    }
];

// ─────────────────────────────────────────────────────────────
// CHANGE TEMPLATES  (short description / description / category)
// ─────────────────────────────────────────────────────────────
var CHANGE_TEMPLATES = [
    {
